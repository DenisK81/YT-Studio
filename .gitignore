# Secrets — real credentials must never be committed. Only .env.example (with empty
# values) belongs in git — see CLAUDE.md.
.env
.env.local
.env.*.local
*/.env
*/.env.local

# Generated media — see ProductionStudio/Assets/README.md. Keep this repo a
# code/prompt/template repo, not a media dump.
ProductionStudio/Assets/images/
ProductionStudio/Assets/audio/
ProductionStudio/Assets/renders/
__pycache__/

# graphify build cache and auto-generated dated backups — regenerable from source,
# not the shared graph itself (graph.json/GRAPH_REPORT.md/graph.html ARE committed).
graphify-out/cache/
graphify-out/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/
