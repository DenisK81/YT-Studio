# Secrets — real credentials must never be committed. Only .env.example (with empty
# values) belongs in git — see CLAUDE.md.
.env
.env.local
.env.*.local
*/.env
*/.env.local

# Real Google/YouTube OAuth credentials and tokens — never committed, only
# Config/.env.example (empty) and the youtube_agent.py code that reads them belong in git.
ProductionStudio/Config/client_secret*.json
ProductionStudio/Config/oauth_yt.txt
ProductionStudio/Config/youtube_token.json

# Generated media — see ProductionStudio/Assets/README.md. Keep this repo a
# code/prompt/template repo, not a media dump.
ProductionStudio/Assets/images/
ProductionStudio/Assets/audio/
ProductionStudio/Assets/renders/
__pycache__/

# graphify output — the knowledge graph is this project's real memory of every case
# (per CLAUDE.md) but lives locally only now, not in git. Regenerate with /graphify --update.
graphify-out/

# Case content (per-video production docs/scripts/prompts) — decided 2026-08-15: video
# content isn't tracked in git anymore, it's already indexed in graphify-out/ (local) and
# the videos themselves are published. The trailing "/" means this only matches
# subdirectories, so ProductionStudio/Cases/covered_cases.json (the case registry, not
# video content) stays tracked without needing a separate negation rule.
ProductionStudio/Cases/*/
